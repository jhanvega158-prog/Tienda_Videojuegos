    "triggers": [
        {
            "body": "CREATE OR REPLACE FUNCTION public.generar_numero_orden()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n\r\n    IF NEW.numero_orden IS NULL\r\n       OR TRIM(NEW.numero_orden) = '' THEN\r\n\r\n        NEW.numero_orden :=\r\n            'ORD-' ||\r\n            TO_CHAR(CURRENT_TIMESTAMP, 'YYYYMMDD') ||\r\n            '-' ||\r\n            LPAD(\r\n                nextval('numero_orden_seq')::TEXT,\r\n                6,\r\n                '0'\r\n            );\r\n\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
            "table": "ordenes",
            "trigger": "trigger_generar_numero_orden",
            "function": "generar_numero_orden",
            "definition": "CREATE TRIGGER trigger_generar_numero_orden BEFORE INSERT ON public.ordenes FOR EACH ROW EXECUTE FUNCTION generar_numero_orden()"
        },
        {
            "body": "CREATE OR REPLACE FUNCTION public.registrar_cambio_estado_pago()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n\r\n    IF OLD.estado IS DISTINCT FROM NEW.estado THEN\r\n\r\n        INSERT INTO auditoria_pagos (\r\n            id_pago,\r\n            estado_anterior,\r\n            estado_nuevo,\r\n            descripcion\r\n        )\r\n        VALUES (\r\n            NEW.id,\r\n            OLD.estado,\r\n            NEW.estado,\r\n            'Cambio de estado del pago'\r\n        );\r\n\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
            "table": "pagos",
            "trigger": "trigger_auditoria_pago",
            "function": "registrar_cambio_estado_pago",
            "definition": "CREATE TRIGGER trigger_auditoria_pago AFTER UPDATE OF estado ON public.pagos FOR EACH ROW EXECUTE FUNCTION registrar_cambio_estado_pago()"
        },
        {
            "body": "CREATE OR REPLACE FUNCTION public.generar_referencia_pago()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n\r\n    IF NEW.referencia IS NULL\r\n       OR TRIM(NEW.referencia) = '' THEN\r\n\r\n        NEW.referencia :=\r\n            'PAY-' ||\r\n            TO_CHAR(CURRENT_TIMESTAMP, 'YYYYMMDD') ||\r\n            '-' ||\r\n            LPAD(\r\n                nextval('referencia_pago_seq')::TEXT,\r\n                6,\r\n                '0'\r\n            );\r\n\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
            "table": "pagos",
            "trigger": "trigger_generar_referencia_pago",
            "function": "generar_referencia_pago",
            "definition": "CREATE TRIGGER trigger_generar_referencia_pago BEFORE INSERT ON public.pagos FOR EACH ROW EXECUTE FUNCTION generar_referencia_pago()"
        },
        {
            "body": "CREATE OR REPLACE FUNCTION public.procesar_pago_aprobado()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n    detalle RECORD;\r\n    usuario_compra INTEGER;\r\nBEGIN\r\n\r\n    -- Solo procesar cuando el pago cambie a PAGADO\r\n    IF NEW.estado = 'PAGADO'\r\n       AND OLD.estado IS DISTINCT FROM 'PAGADO' THEN\r\n\r\n        -- Obtener usuario dueño de la orden\r\n        SELECT id_usuario\r\n        INTO usuario_compra\r\n        FROM public.ordenes\r\n        WHERE id = NEW.id_orden;\r\n\r\n        IF usuario_compra IS NULL THEN\r\n            RAISE EXCEPTION 'No se encontró el usuario de la orden';\r\n        END IF;\r\n\r\n        -- Cambiar orden a PAGADA\r\n        UPDATE public.ordenes\r\n        SET estado = 'PAGADA'\r\n        WHERE id = NEW.id_orden;\r\n\r\n        -- Recorrer los productos comprados\r\n        FOR detalle IN\r\n            SELECT\r\n                id_videojuego,\r\n                cantidad\r\n            FROM public.orden_detalle\r\n            WHERE id_orden = NEW.id_orden\r\n        LOOP\r\n\r\n            -- Verificar stock\r\n            IF (\r\n                SELECT stock\r\n                FROM public.videojuegos\r\n                WHERE id = detalle.id_videojuego\r\n            ) < detalle.cantidad THEN\r\n\r\n                RAISE EXCEPTION\r\n                'Stock insuficiente para el videojuego ID %',\r\n                detalle.id_videojuego;\r\n\r\n            END IF;\r\n\r\n            -- Descontar stock\r\n            UPDATE public.videojuegos\r\n            SET stock = stock - detalle.cantidad\r\n            WHERE id = detalle.id_videojuego;\r\n\r\n            -- Agregar juego a biblioteca\r\n            INSERT INTO public.biblioteca (\r\n                id_usuario,\r\n                id_videojuego,\r\n                id_orden,\r\n                fecha_adquisicion,\r\n                activo\r\n            )\r\n            VALUES (\r\n                usuario_compra,\r\n                detalle.id_videojuego,\r\n                NEW.id_orden,\r\n                CURRENT_TIMESTAMP,\r\n                TRUE\r\n            )\r\n            ON CONFLICT (id_usuario, id_videojuego)\r\n            DO NOTHING;\r\n\r\n        END LOOP;\r\n\r\n        -- Vaciar carrito después de compra exitosa\r\n        DELETE FROM public.carrito_detalle\r\n        WHERE id_carrito = (\r\n            SELECT id\r\n            FROM public.carritos\r\n            WHERE id_usuario = usuario_compra\r\n        );\r\n\r\n        -- Registrar fecha del pago\r\n        NEW.fecha_pago := CURRENT_TIMESTAMP;\r\n\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
            "table": "pagos",
            "trigger": "trigger_procesar_pago_aprobado",
            "function": "procesar_pago_aprobado",
            "definition": "CREATE TRIGGER trigger_procesar_pago_aprobado BEFORE UPDATE OF estado ON public.pagos FOR EACH ROW EXECUTE FUNCTION procesar_pago_aprobado()"
        }
    ],
